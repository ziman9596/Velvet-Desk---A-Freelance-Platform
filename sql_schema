-- 1. Users Table
CREATE TABLE IF NOT EXISTS orders (
    order_id INTEGER PRIMARY KEY AUTOIONCREMENT,
    gig_id INTEGER,
    buyer_id INTEGER,
    seller_id INTEGER,
    order_status TEXT DEFAULT 'In Progress', -- In Progress, Delivered, Completed
    delivery_file_path TEXT DEFAULT NULL,
    submission_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(gig_id) REFERENCES gigs(gig_id),
    FOREIGN KEY(buyer_id) REFERENCES users(user_id),
    FOREIGN KEY(seller_id) REFERENCES users(user_id)
);

-- 2. Gigs Table (Services)
CREATE TABLE gigs (
    gig_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT, -- Foreign Key referencing Users (Seller)
    title VARCHAR(255) NOT NULL,
    description TEXT NOT NULL,
    price DECIMAL(10, 2) NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- 3. Orders Table (With Payment Status)
CREATE TABLE orders (
    order_id INT AUTO_INCREMENT PRIMARY KEY,
    gig_id INT,    -- Foreign Key referencing Gigs
    buyer_id INT,  -- Foreign Key referencing Users (Buyer)
    amount DECIMAL(10, 2) NOT NULL,
    payment_status VARCHAR(20) DEFAULT 'Pending', -- 'Pending', 'Paid'
    order_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (gig_id) REFERENCES gigs(gig_id),
    FOREIGN KEY (buyer_id) REFERENCES users(user_id)
);
